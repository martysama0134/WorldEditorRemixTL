/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "Dosya"
    BEGIN
        MENUITEM "Cikis",                        ID_APP_EXIT
    END
    POPUP "Duzen"
    BEGIN
        MENUITEM "Geri Al...\tCtrl+Z",             ID_EDIT_UNDO
        MENUITEM "Yinele...\tCtrl+Y",             ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Kes...\tCtrl+X",              ID_EDIT_CUT
        MENUITEM "Kopyala...\tCtrl+C",             ID_EDIT_COPY
        MENUITEM "Yapistir...\tCtrl+V",            ID_EDIT_PASTE
    END
    POPUP "Gorunum"
    BEGIN
        MENUITEM "Toolbar(&T)",                     ID_VIEW_TOOLBAR
        MENUITEM "Durum Cubugu",                   ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        POPUP "Goruntuleme Modu"
        BEGIN
            MENUITEM "Dolu",                       ID_VIEW_RENDERING_MODE_SOLID
            MENUITEM "Tel Kafes",                  ID_VIEW_RENDERING_MODE_WIRE_FRAME
        END
        MENUITEM "Hakkinda Kutusu(F11)",              ID_VIEW_INFO_BOX
        MENUITEM SEPARATOR
        MENUITEM "Arac Cubugu(&T)",                 ID_VIEW_TOOLBAR
        MENUITEM "Harita Kontrol Cubugu",             ID_VIEW_MAP
        MENUITEM "Nesne Kontrol Cubugu",         ID_VIEW_OBJECT
        MENUITEM "Efekt Kontrol Cubugu",          ID_VIEW_EFFECT
        MENUITEM SEPARATOR
        MENUITEM "Perspektif Ayari",          ID_VIEW_DLG_PERSPECTIVE
    END
    POPUP "Bilgi"
    BEGIN
        MENUITEM "WorldEditor Hakkinda...",        ID_APP_ABOUT
    END
END


